# ============================================================
# SAPA BPS 1901 - FRONTEND ENVIRONMENT VARIABLES (TEMPLATE)
# ============================================================
# Salin file ini menjadi .env.local untuk menggunakannya:
# cp .env.example .env.local

# URL Internal Backend Server Express (Port 80 Lokal Windows)
BACKEND_INTERNAL_URL=http://127.0.0.1:80

# URL Publik Backend API (Ngrok Public HTTPS Tunnel)
NEXT_PUBLIC_BACKEND_URL=https://footless-aptitude-caloric.ngrok-free.dev

# Token Keamanan API Key Backend
NEXT_PUBLIC_API_KEY=sapa_bps_secure_token_2026

# Konfigurasi Aplikasi & Wilayah Kerja BPS
NEXT_PUBLIC_APP_NAME="SAPA BPS 1901"
NEXT_PUBLIC_BPS_REGION="Kabupaten Bangka"
NEXT_PUBLIC_BPS_CODE="1901"
NEXT_PUBLIC_APP_VERSION="2.1.0"
